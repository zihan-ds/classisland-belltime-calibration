<ci:SettingsPageBase
    x:Class="BellTimeCalibration.Settings.BellCalibrationSettingsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
    ActualThemeVariantChanged="OnActualThemeVariantChanged">

  <!-- ═══ 主题资源 ═══
       本页原先把颜色硬编码成半透明白（卡片 #18FFFFFF、提示文字 #88FFFFFF/#AAFFFFFF），
       那套配色只在深色模式下可读；切到浅色模式后提示文字几乎看不见。
       这里改为 ThemeVariant 键控的资源字典：Avalonia 会按当前主题变体自动取 Light / Dark 一组，
       因此不依赖宿主是否提供某个具名画刷，也不需要写任何主题切换代码。 -->
  <ci:SettingsPageBase.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="BellCardBackgroundBrush" Color="#0A000000"/>
          <SolidColorBrush x:Key="BellHintBrush" Color="#C0000000"/>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="BellCardBackgroundBrush" Color="#18FFFFFF"/>
          <SolidColorBrush x:Key="BellHintBrush" Color="#AAFFFFFF"/>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </ci:SettingsPageBase.Resources>

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">

      <!-- ═══ 基本开关 ═══ -->
      <Border Classes="bellcard" Background="{DynamicResource BellCardBackgroundBrush}" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="8">
          <TextBlock Text="基本开关" FontSize="15" FontWeight="Bold"/>

          <CheckBox Content="启用铃声自动校时"
                    IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
          <TextBlock Text="总开关。关闭后不再监听铃声，也不自动调整时间（下方「手动拟合并应用」除外）。"
                     Classes="bellhint" FontSize="12" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>

          <CheckBox Content="学习模式（默认开启）"
                    IsChecked="{Binding IsLearningMode, Mode=TwoWay}"/>
          <TextBlock Text="仅记录识别到的铃声和推算偏移，不修改系统时间。建议先观察几天确认识别稳定。"
                     Classes="bellhint" FontSize="12" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>

          <CheckBox Content="自动应用校准偏移"
                    IsChecked="{Binding IsAutoApplyEnabled, Mode=TwoWay}"/>
          <TextBlock Text="自动把校准结果写入 ClassIsland 时间偏移。需先关闭上方「学习模式」才生效。"
                     Classes="bellhint" FontSize="12" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- ═══ 手动拟合 ═══ -->
      <Border Classes="bellcard" Background="{DynamicResource BellCardBackgroundBrush}" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="8">
          <TextBlock Text="手动拟合" FontSize="15" FontWeight="Bold"/>
          <TextBlock Text="读取当天勾选的样本重新计算时间偏移，并立即应用到 ClassIsland（不受总开关或学习模式限制）。"
                     Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>

          <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Content="手动拟合并应用" Click="OnManualFit"/>
            <TextBlock Grid.Column="1" Name="FitResultText" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontSize="12" TextWrapping="Wrap"
                       Text="尚未执行。"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══ 样本管理 ═══ -->
      <Border Classes="bellcard" Background="{DynamicResource BellCardBackgroundBrush}" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="8">
          <TextBlock Text="样本管理" FontSize="15" FontWeight="Bold"/>
          <TextBlock Text="管理当天记录的铃声样本。勾选的样本会参与「手动拟合」，可根据实际听铃情况手动剔除误识别或纳入漏选的样本。「采用偏移」显示纳入该行后重新拟合的预计偏移值。"
                     Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>

          <Grid ColumnDefinitions="Auto,*">
            <Button Grid.Column="0" Content="重新载入" Click="OnReloadSamples"/>
            <TextBlock Grid.Column="1" Name="SampleSummaryText" Margin="10,0,0,0" VerticalAlignment="Center"
                       FontSize="12" TextWrapping="Wrap" Text="正在载入…"/>
          </Grid>

          <Grid ColumnDefinitions="120,60,110,130,110,80,110,*" Margin="0,4,0,0">
            <TextBlock Grid.Column="0" Text="铃响时刻" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="类型" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="课表边界" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="3" Text="当时偏移" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="采用偏移" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="判据写入" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="判据位置" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="7" Text="参与拟合" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
          </Grid>

          <ItemsControl Name="SampleList">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="120,60,110,130,110,80,110,*" Margin="0,2,0,2">
                  <TextBlock Grid.Column="0" Text="{Binding TimeText}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="{Binding Boundary}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="3" Text="{Binding InputOffsetText}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="{Binding AdoptOffsetText}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="5" Text="{Binding AppliedText}" FontSize="12" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="6" Text="{Binding OriginText}" FontSize="12" VerticalAlignment="Center"/>
                  <!-- 勾选框默认按拉伸对齐，会比同一行的文字偏上；显式垂直居中，并用负外边距抵掉它自带的内边距 -->
                  <CheckBox Grid.Column="7" Margin="0,-2,0,-2" VerticalAlignment="Center"
                            IsChecked="{Binding Valid, Mode=TwoWay}"/>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <TextBlock Name="SampleEmptyText" Text="当天暂无样本。" FontSize="12"
                     Classes="bellhint" Foreground="{DynamicResource BellHintBrush}" IsVisible="False"/>
        </StackPanel>
      </Border>

      <!-- ═══ 监听参数 ═══ -->
      <Border Classes="bellcard" Background="{DynamicResource BellCardBackgroundBrush}" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="10">
          <TextBlock Text="监听参数" FontSize="15" FontWeight="Bold"/>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="布防提前秒数" FontSize="13"/>
              <TextBlock Text="距离时间边界多少秒开始布防监听铃声" Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Width="130"
                            Minimum="0" Maximum="300" Increment="1" FormatString="0"
                            Value="{Binding ArmedLeadSeconds, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="边界后监听秒数" FontSize="13"/>
              <TextBlock Text="越过时间边界后继续监听多少秒" Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Width="130"
                            Minimum="0" Maximum="120" Increment="1" FormatString="0"
                            Value="{Binding WindowSeconds, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="铃响搜索半窗（±秒）" FontSize="13"/>
              <TextBlock Text="模板匹配的搜索范围（秒）。仅在起响沿闸门未命中时兜底生效；长铃会自动向前回溯起点。" Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Width="130"
                            Minimum="1" Maximum="30" Increment="1" FormatString="0.#"
                            Value="{Binding ToleranceSeconds, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="应用死区（秒）" FontSize="13"/>
              <TextBlock Text="计算偏移与当前偏移之差小于此值时不写入，避免频繁微调。" Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Width="130"
                            Minimum="0" Maximum="30" Increment="0.5" FormatString="0.#"
                            Value="{Binding DeadZoneSeconds, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="单次写入上限（秒）" FontSize="13"/>
              <TextBlock Text="单次最多调整的秒数。偏差过大时会自动按此步进分多次逼近，防止时间突变。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Width="130"
                            Minimum="1" Maximum="60" Increment="0.5" FormatString="0.#"
                            Value="{Binding LargeErrorLimitSeconds, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="人工审核提醒（分步写入时弹窗）" FontSize="13"/>
              <TextBlock Text="遇到需要分步调整的大偏差或识别冲突时弹出提醒；关闭后仍正常分步校准，仅不弹窗提示。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox Grid.Column="1" VerticalAlignment="Center"
                      IsChecked="{Binding EnableReviewNotification, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="忽略的边界时刻" FontSize="13"/>
              <TextBlock Text="不监听、不校准的时间点（格式 HH:mm，逗号分隔，如 12:00,18:00）。留空表示全部监听。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Center" Width="130"
                     Watermark="留空=不忽略"
                     Text="{Binding IgnoredBoundaries, Mode=TwoWay}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══ 识别参数 ═══ -->
      <Border Classes="bellcard" Background="{DynamicResource BellCardBackgroundBrush}" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="10">
          <TextBlock Text="识别参数" FontSize="15" FontWeight="Bold"/>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="识别灵敏度" FontSize="13"/>
              <TextBlock Text="铃声突发能量与环境噪声的比值门槛（默认 2.0）。数值越高越防误判，数值越低越容易捕捉微弱铃声。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Width="130"
                            Minimum="0.1" Maximum="10" Increment="0.1" FormatString="0.#"
                            Value="{Binding DetectionSensitivity, Mode=TwoWay}"/>
          </Grid>
        </StackPanel>
      </Border>

      <!-- ═══ 模板匹配（铃声样本） ═══ -->
      <Border Classes="bellcard" Background="{DynamicResource BellCardBackgroundBrush}" CornerRadius="6" Padding="14,10">
        <StackPanel Spacing="10">
          <TextBlock Text="模板匹配（铃声样本）" FontSize="15" FontWeight="Bold"/>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="启用模板匹配" FontSize="13"/>
              <TextBlock Text="辅助判据。导入真实铃声录音作为特征模板，在主闸门未命中或噪声较大时辅助锁定起响位置。未配置模板时自动跳过。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding EnableTemplateMatch, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="模板目录" FontSize="13"/>
              <TextBlock Text="存放铃声模板的相对路径（留空即默认 Templates 目录）。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <TextBox Grid.Column="1" VerticalAlignment="Center" Width="130" Watermark="Templates"
                     Text="{Binding TemplateDirectory, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="上课铃样本 / 截取区间" FontSize="13"/>
              <TextBlock Text="选择含上课铃声的 WAV 录音。「截取区间」填起始-结束秒（如 12.0-14.5），留空则自动截取最响铃声段。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Width="220">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Watermark="上课铃样本.wav" Text="{Binding ClassBellSamplePath, Mode=TwoWay}"/>
                <Button Grid.Column="1" Content="浏览…" Margin="6,0,0,0" Click="OnBrowseClassBellSample"/>
              </Grid>
              <TextBox Watermark="如 12.0-14.5" Text="{Binding ClassBellTrimSeconds, Mode=TwoWay}"/>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="下课铃样本 / 截取区间" FontSize="13"/>
              <TextBlock Text="选择含下课铃声的 WAV 录音，规则同上。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6" Width="220">
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Watermark="下课铃样本.wav" Text="{Binding BreakBellSamplePath, Mode=TwoWay}"/>
                <Button Grid.Column="1" Content="浏览…" Margin="6,0,0,0" Click="OnBrowseBreakBellSample"/>
              </Grid>
              <TextBox Watermark="如 5.0-7.5" Text="{Binding BreakBellTrimSeconds, Mode=TwoWay}"/>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="匹配阈值：波形 NCC" FontSize="13"/>
              <TextBlock Text="归一化互相关系数门槛（越接近 1.0 越严格，默认 0.60）。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Width="130"
                            Minimum="0.1" Maximum="0.99" Increment="0.05" FormatString="0.00"
                            Value="{Binding MatchNccMin, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="匹配阈值：音色相似度" FontSize="13"/>
              <TextBlock Text="频段音色相似度门槛（默认 0.45）。主要用于过滤音色不符的嘈杂环境音。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <NumericUpDown Grid.Column="1" VerticalAlignment="Center" Width="130"
                            Minimum="0.1" Maximum="0.99" Increment="0.05" FormatString="0.00"
                            Value="{Binding MatchSpectralMin, Mode=TwoWay}"/>
          </Grid>
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="复核提醒" FontSize="13"/>
              <TextBlock Text="单次步进调整或识别冲突时触发提示。可在此发送测试提醒，确认通知能否正常弹出。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Content="发送测试提醒" Click="OnTestReviewNotification"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="调试音频转存" FontSize="13"/>
              <TextBlock Text="默认关闭。开启后将监听窗口录音保存为 WAV（存放于 Dumps 目录），仅供排查误识或采集模板。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <CheckBox Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding DebugDumpAudio, Mode=TwoWay}"/>
          </Grid>

          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="2">
              <TextBlock Text="清除无用录音" FontSize="13"/>
              <TextBlock Text="清理 Dumps 目录下超过 7 天且非测试夹具的调试录音，不影响模板、设置和日志。点击后 10 秒内再次点击即确认清理。"
                         Classes="bellhint" FontSize="11" Foreground="{DynamicResource BellHintBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" Content="清除无用录音" Click="OnClearDumps"/>
          </Grid>
          <TextBlock Name="ClearDumpsText" FontSize="12" TextWrapping="Wrap" Text=""/>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</ci:SettingsPageBase>
