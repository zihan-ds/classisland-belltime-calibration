<UserControl x:Class="BellTimeCalibration.Settings.BellReviewProviderSettingsControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="520" d:DesignHeight="220">
  <!--
    「设置 → 提醒 → 铃声校时复核 → 基本设置」里显示的内容。
    刻意不用任何自定义主题画刷：这里由宿主的设置页承载，跟随宿主主题即可（浅色/深色都可读）。
    开关与插件设置页里的那个是同一份配置（BellTimeCalibrationPlugin.Config）。
  -->
  <ScrollViewer>
    <StackPanel Spacing="14" Margin="0 4 0 8" MaxWidth="720" HorizontalAlignment="Left">

      <StackPanel Spacing="4">
        <TextBlock Text="铃声校时复核" FontSize="15" FontWeight="Bold"/>
        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.75"
                   Text="当遇到单次无法一次性消除的大偏差（需要分步调整）或两处测量结果冲突时，在此向你发出人工确认提醒。"/>
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="人工审核提醒（分步写入时弹窗）" FontSize="13"/>
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                     Text="关闭后仍按安全步进正常校准，仅不再弹窗打扰（相关记录可在日志中查看）。"/>
        </StackPanel>
        <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                  x:Name="ReviewEnabledToggle"/>
      </Grid>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="2">
          <TextBlock Text="发送测试提醒" FontSize="13"/>
          <TextBlock TextWrapping="Wrap" FontSize="11" Opacity="0.75"
                     Text="发送一条模拟提醒，用于测试通知通道能否在界面上正常弹出（不受上方开关限制）。"/>
        </StackPanel>
        <Button Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"
                Content="发送测试提醒" Click="OnTestReviewNotification"/>
      </Grid>

      <TextBlock x:Name="TestResultText" FontSize="11" Opacity="0.75"
                 TextWrapping="Wrap" IsVisible="False"/>

    </StackPanel>
  </ScrollViewer>
</UserControl>
